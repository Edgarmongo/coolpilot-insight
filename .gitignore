# 虚拟环境
.venv/
# IDE缓存
.idea/
.vscode/
.claude/
# python缓存
__pycache__/
*.pyc
*.pyo

# 前端依赖
node_modules/
dist/

# Java 编译产物
target/
*.class

# Docker
.env

# E2E 截图与临时脚本（体积大且每次重跑都会变，不入库）
.workbuddy/e2e/

# 采集原始数据（保留目录占位，不提交内容）
collection-service/datas/*
!collection-service/datas/.gitkeep
deploy/backup/*

# 凭证目录：只保留占位文件，凭证内容禁止入库
runtime/secrets/**
!runtime/secrets/account/.gitkeep

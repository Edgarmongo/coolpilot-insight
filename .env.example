# ============================================================
# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取同目录下的 .env
# ============================================================

# ---- MySQL ----
DB_PASSWORD=changeme
DB_NAME=coolpilot_insight

# ---- 宿主机端口映射（避开本机已被占用的 3306 / 3000）----
MYSQL_HOST_PORT=3307
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=5173

# ---- 安全 ----
# JWT_SECRET 为必填项：缺失时 docker compose 会直接报错退出
# 生产环境请务必替换为随机长字符串（例如 openssl rand -hex 32 的输出）
JWT_SECRET=changeme-generate-a-random-64-char-string
# 首次启动时创建的管理员初始密码；留空则不创建
ADMIN_INIT_PASSWORD=
# 后端调用 Flask 分词/AI 服务的内部鉴权令牌；留空则不校验
FLASK_INTERNAL_TOKEN=

# ---- AI 话题分析（可选）----
# 不配置时，核心话题分析自动降级为传统统计报告，不影响其他功能
DEEPSEEK_API_KEY=
